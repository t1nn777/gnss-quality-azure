<mxfile host="app.diagrams.net">
  <diagram id="gnss-arch" name="Architecture">
    <mxGraphModel dx="1700" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;GNSS Trace Quality Checker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5A6570&quot;&gt;How a simulated GPS trace gets cleaned on Azure&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="520" height="60" as="geometry"/>
        </mxCell>

        <!-- ================= GitHub ================= -->
        <mxCell id="gh" value="GitHub" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#D0D7DE;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fontColor=#24292F;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="490" as="geometry"/>
        </mxCell>
        <mxCell id="dev" value="You" style="shape=umlActor;verticalLabelPosition=middle;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=6;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#24292F;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="175" y="120" width="28" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6570&quot;&gt;api/ · ui/ · databricks/ · infra/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="205" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="geo" value="&lt;b&gt;geo/&lt;/b&gt;  one shared algorithm module" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#E3F4F1;strokeColor=#0E8A7E;strokeWidth=2;fontColor=#0B6B62;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="265" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="actions" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;✓ &lt;b&gt;ci&lt;/b&gt; – tests on every PR&lt;br&gt;✓ &lt;b&gt;infra&lt;/b&gt; – Terraform plan / apply&lt;br&gt;✓ &lt;b&gt;deploy-app&lt;/b&gt; – ships API + UI&lt;br&gt;✓ &lt;b&gt;deploy-databricks&lt;/b&gt; – ships the job&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C959F;verticalAlign=top;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="375" width="240" height="185" as="geometry"/>
        </mxCell>

        <!-- ================= Notes (why it looks like this) ================= -->
        <mxCell id="n1" value="&lt;b&gt;Only ~4 vCPU allowed&lt;/b&gt;&lt;br&gt;so Databricks runs on a single node" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF4C2;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;B1 plan, not free F1&lt;/b&gt;&lt;br&gt;Streamlit needs websockets" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF4C2;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="705" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Budget under 10 USD&lt;/b&gt;&lt;br&gt;down.ps1 removes it all, up.ps1 rebuilds it" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF4C2;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;All data is simulated&lt;/b&gt;&lt;br&gt;ground truth kept to measure error" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF4C2;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
